# ==============================================================================
# AI RECRUITMENT INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application & Security
ENVIRONMENT=production
PROJECT_NAME="AI Recruitment Intelligence Platform"
SECRET_KEY="super-secret-jwt-signing-key-change-this-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./data/platform.db

# Storage & Retrieval Paths
CACHE_DIR=./cache
DATASET_PATH=./data/dataset/candidates.jsonl
FAISS_INDEX_PATH=./cache/candidate.index
EMBEDDINGS_PATH=./cache/candidate_embeddings.npy
CANDIDATE_IDS_PATH=./cache/candidate_ids.pkl
CANDIDATE_DOCUMENTS_PATH=./cache/candidate_documents.pkl
OFFSETS_PATH=./cache/candidate_offsets.pkl

# AI Models & Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
GEMINI_API_KEY=

# Retrieval Engine Hyperparameters
RETRIEVAL_TOP_N=1500
DEFAULT_TOP_K=20

# Multi-Signal Weights (Must sum to 1.0)
SEMANTIC_WEIGHT=0.25
BM25_WEIGHT=0.10
REQUIRED_SKILL_WEIGHT=0.25
PREFERRED_SKILL_WEIGHT=0.10
EXPERIENCE_WEIGHT=0.15
EDUCATION_WEIGHT=0.05
CAREER_ALIGNMENT_WEIGHT=0.05
AVAILABILITY_WEIGHT=0.05
